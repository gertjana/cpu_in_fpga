      "updated": 1774434263162,
      "link": null,
      "locked": false,
      "text": ".equ PRNG_PORT,     0x01     ; Port 1 is PRNG\n.equ LEDS_PORT,     0x02     ; Port 2 is LEDs\n.equ INITIAL_SEED,  0x28   \n\n        LDI  R0, INITIAL_SEED     \n        OUT  R0, PRNG_PORT\nloop:\n        IN   R7, PRNG_PORT\n        OUT  R7, LEDS_PORT\n        JMP  loop    ",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "R4lDyIrxFia0vjvgw7EvU",
      "originalText": ".equ PRNG_PORT,     0x01     ; Port 1 is PRNG\n.equ LEDS_PORT,     0x02     ; Port 2 is LEDs\n.equ INITIAL_SEED,  0x28   \n\n        LDI  R0, INITIAL_SEED     \n        OUT  R0, PRNG_PORT\nloop:\n        IN   R7, PRNG_PORT\n        OUT  R7, LEDS_PORT\n        JMP  loop    ",
      "autoResize": true,
      "lineHeight": 1.25
