// FPGA Demo Program — infinite counter loop
// Counts R0 from 0 to 62, compares to 63, loops back, then restarts.
// Flags Z/C/N/V update continuously, giving changing LED patterns.
//
// Generated by: python3 tools/assembler.py examples/infinite_counter.asm
//
// Addr  Hex    Assembly
// 0     2000   LDI  R0, 0        ; R0 = 0  (counter)
// 1     207F   LDI  R1, 63       ; R1 = 63 (limit, max 6-bit LDI immediate)
// 2     1001   ADDI R0, R0, 1    ; R0++  (sets Z/C/N/V)
// 3     6008   CMP  R0, R1       ; flags = R0 - R1
// 4     4402   JNZ  loop         ; loop back if R0 != 63
// 5     4000   JMP  0            ; restart (truly infinite)
2000
207F
1001
6008
4402
4000
