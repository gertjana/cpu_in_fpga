# =============================================================================
# cpu_fpga.qsf  —  Quartus Settings File for the 8-bit CPU on MAX1000
#
# Board: Arrow MAX1000 (Intel MAX 10, 10M16SAU169C8G)
# Toolchain: Quartus Prime (Lite edition is sufficient)
#
# Usage:
#   1. Open Quartus → File → Open Project → select this .qsf
#      (or: quartus_sh --flow compile quartus/cpu_fpga.qsf)
#   2. Quartus compiles all RTL listed under SOURCE_FILE below.
#   3. program.hex must be present in the project directory (copy from
#      quartus/program.hex to the root, or adjust ROM_INIT in top.v).
# =============================================================================

# ---------------------------------------------------------------------------
# Device & project settings
# ---------------------------------------------------------------------------
set_global_assignment -name DEVICE 10M16SAU169C8G
set_global_assignment -name FAMILY "MAX 10"
set_global_assignment -name NUM_PARALLEL_PROCESSORS ALL
set_global_assignment -name TOP_LEVEL_ENTITY top
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
set_global_assignment -name DEVICE_FILTER_PACKAGE UFBGA
set_global_assignment -name DEVICE_FILTER_PIN_COUNT 169

# ---------------------------------------------------------------------------
# Source files (all Verilog)
# ---------------------------------------------------------------------------
set_global_assignment -name VERILOG_FILE ../rtl/top.v
set_global_assignment -name VERILOG_FILE ../rtl/cpu.v
set_global_assignment -name VERILOG_FILE ../rtl/alu.v
set_global_assignment -name VERILOG_FILE ../rtl/regfile.v
set_global_assignment -name VERILOG_FILE ../rtl/pc.v
set_global_assignment -name VERILOG_FILE ../rtl/decoder.v
set_global_assignment -name VERILOG_FILE ../rtl/rom.v
set_global_assignment -name VERILOG_FILE ../rtl/ram.v
set_global_assignment -name VERILOG_FILE ../rtl/stack.v
set_global_assignment -name VERILOG_FILE ../rtl/prng.v
set_global_assignment -name VERILOG_FILE ../rtl/oled_monitor.v
set_global_assignment -name VERILOG_FILE ../rtl/input_barrier.v

# alt_adc_ctrl IP — MAX10 internal ADC controller (Platform Designer / Qsys).
# Generate this IP in Quartus: IP Catalog → Library → Basic Functions →
#   On Chip Memory → Altera Modular ADC Core → configure for 1 channel
#   (ANAIN, channel 0), continuous sampling, 12-bit, clock = 12 MHz.
# The generated .qip file will add the correct simulation models and
# synthesis netlists automatically.  Add the generated .qip path here:
set_global_assignment -name QIP_FILE alt_adc_ctrl/synthesis/alt_adc_ctrl.qip
set_global_assignment -name QIP_FILE alt_pll/synthesis/alt_pll.qip

# ---------------------------------------------------------------------------
# Pin assignments — MAX1000 well-known pinout
# ---------------------------------------------------------------------------

# 12 MHz oscillator
set_location_assignment PIN_H6 -to clk_12m

# USER_BTN button (active-low, pin E6, Schmitt trigger)
#   Short press (<0.5 s) — toggles LED display mode
#   Long  press (≥0.5 s) — resets the CPU
set_location_assignment PIN_E6 -to rst_n

# LEDs (active-low: drive 0 to illuminate)
#   LED[0] = flag C (carry)          — pin A8
#   LED[1] = flag V (overflow)       — pin A9
#   LED[2] = heartbeat / halt        — pin A11
#   LED[3] = PC[4]                   — pin A10
#   LED[4] = PC[3]                   — pin B10
#   LED[5] = PC[2]                   — pin C9
#   LED[6] = PC[1]                   — pin C10
#   LED[7] = PC[0]                   — pin D8
set_location_assignment PIN_A8  -to led[0]
set_location_assignment PIN_A9  -to led[1]
set_location_assignment PIN_A11 -to led[2]
set_location_assignment PIN_A10 -to led[3]
set_location_assignment PIN_B10 -to led[4]
set_location_assignment PIN_C9  -to led[5]
set_location_assignment PIN_C10 -to led[6]
set_location_assignment PIN_D8  -to led[7]

# ---------------------------------------------------------------------------
# I/O standards
# ---------------------------------------------------------------------------
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to clk_12m
set_instance_assignment -name IO_STANDARD "3.3 V Schmitt Trigger" -to rst_n
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to led[0]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to led[1]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to led[2]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to led[3]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to led[4]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to led[5]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to led[6]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to led[7]

# GPIO — 8 bidirectional pins on the MKR-compatible J1/J2 headers.
# Board refs D0–D7 map to these FPGA balls.
#   gpio[0] = D0   J1/9    PIN_H8
#   gpio[1] = D1   J1/10   PIN_K10
#   gpio[2] = D2   J1/11   PIN_H5
#   gpio[3] = D3   J1/12   PIN_H4
#   gpio[4] = D4   J1/13   PIN_J1
#   gpio[5] = D5   J1/14   PIN_J2
#   gpio[6] = D6   J2/1    PIN_L12
#   gpio[7] = D7   J2/2    PIN_J12
set_location_assignment PIN_H8  -to gpio[0]
set_location_assignment PIN_K10 -to gpio[1]
set_location_assignment PIN_H5  -to gpio[2]
set_location_assignment PIN_H4  -to gpio[3]
set_location_assignment PIN_J1  -to gpio[4]
set_location_assignment PIN_J2  -to gpio[5]
set_location_assignment PIN_L12 -to gpio[6]
set_location_assignment PIN_J12 -to gpio[7]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to gpio[0]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to gpio[1]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to gpio[2]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to gpio[3]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to gpio[4]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to gpio[5]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to gpio[6]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to gpio[7]
# Note: WEAK_PULL_UP_RESISTOR is not applied by Quartus to bidirectional
# (inout) pins that have an output-enable.  Floating GPIO pins will read
# unpredictably; drive all pins to a known level (3.3V or GND) for stable
# results with gpio_in.asm.

# ADC — The MAX10 internal ADC hard block samples the dedicated analogue input
# pin ANAIN (PIN_D2, labelled AIN on the dedicated 3-pin header at the top-left of the board).
# The alt_adc_ctrl IP core is instantiated inside top.v and drives the ADC
# hard block.  PIN_D2 is a dedicated analogue-only pin — it is connected
# internally by the IP and must NOT be declared as a top-level digital port.
# No pin assignment or I/O standard is needed here.
set_global_assignment -name SDC_FILE cpu_fpga.sdc

set_global_assignment -name LAST_QUARTUS_VERSION "22.1std.2 Lite Edition"

# ---------------------------------------------------------------------------
# oled_monitor synthesis constraints
#
# Quartus performs global constant-propagation and, for simple programs with
# small bounded CPUs (e.g. adc where only R0 changes, R1-R7 always 0), can
# prove the value of every CPU register at every cycle.  It then applies
# Auto Clock Enable (ACE) optimisation to the oled_monitor input pipeline
# FFs: it derives a CE from the MSB of a CPU register (e.g. R0[7]=0 always)
# and uses it to gate all bits of r0_r — so the FF never loads, and
# cur_ascii/font_byte are driven by stale zero data, producing a blank
# display.
#
# This is solved by routing CPU inputs through input_barrier.v, whose output
# registers carry (* preserve, noprune, dont_merge *) attributes.  Quartus
# synthesizes the FFs normally but cannot optimise across the barrier.
#
# NOTE: An earlier version used /* synthesis black_box */ on input_barrier.
# That directive caused Quartus to skip synthesizing the module body entirely,
# leaving outputs undriven (GND) for some programs — producing a completely
# blank OLED.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# PmodOLED — MAX1000 PMOD header (12-pin, 2×6)
#
# PMOD Pin → MAX1000 FPGA Pin → PmodOLED Signal
#   Pin  1   PIN_M3   CS      (SPI chip select, active low)
#   Pin  2   PIN_L3   SDIN    (SPI MOSI)
#   Pin  3   PIN_M2   (unused on PmodOLED)
#   Pin  4   PIN_M1   SCLK    (SPI clock)
#   Pin  7   PIN_N3   D/C     (Data=1 / Command=0)
#   Pin  8   PIN_N2   RES     (Reset, active low)
#   Pin  9   PIN_K2   VBATC   (Display panel power control, active low)
#   Pin 10   PIN_K1   VDDC    (Logic power control, active low)
#   Pins 5,11 = GND (no assignment needed)
#   Pins 6,12 = 3.3V (no assignment needed)
# ---------------------------------------------------------------------------
set_location_assignment PIN_M3 -to pmod_cs_n
set_location_assignment PIN_L3 -to pmod_mosi
set_location_assignment PIN_M1 -to pmod_sclk
set_location_assignment PIN_N3 -to pmod_dc
set_location_assignment PIN_N2 -to pmod_res_n
set_location_assignment PIN_K2 -to pmod_vbatc
set_location_assignment PIN_K1 -to pmod_vddc

set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to pmod_cs_n
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to pmod_mosi
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to pmod_sclk
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to pmod_dc
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to pmod_res_n
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to pmod_vbatc
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to pmod_vddc

# Weak pull-ups on OLED control and chip-select pins.
# During FPGA configuration (~100 ms) all I/O pins are tri-stated. Without
# pull-ups, pmod_res_n floats and the SSD1306 may latch into a bad reset
# state; vbatc/vddc may float low and power the display before the FSM can
# run the controlled power-on sequence; and — critically — pmod_cs_n may
# float low, causing the SSD1306 to interpret noise on the floating SCLK
# and MOSI lines as valid SPI commands.  This can corrupt the SSD1306's
# internal state (charge pump, addressing mode, display on/off) in ways
# that the subsequent init sequence cannot always recover from.
#
# These pull-ups (~25 kΩ) keep the lines at their safe idle levels until
# the bitstream drives them.  They have no effect during normal operation
# because the FPGA output drivers override them.
#
#   pmod_cs_n  — high = SSD1306 deselected, ignores SCLK/MOSI noise
#   pmod_res_n — high = SSD1306 not in reset
#   pmod_vbatc — high = display panel power OFF
#   pmod_vddc  — high = logic power OFF
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to pmod_cs_n
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to pmod_res_n
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to pmod_vbatc
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to pmod_vddc

