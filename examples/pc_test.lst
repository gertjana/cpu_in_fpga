Addr  Word  Source
------------------------------------------------------------
            ; pc_test.asm — PC LED test
            ; Counts PC through 0..8 visibly on LEDs[7:5], then jumps back to 0.
            ; At ~1.4 Hz CPU clock each step is clearly visible.
            ;
            ; Expected LED sequence (LED7..LED5 = PC[2..0]):
            ;   000 001 010 011 100 101 110 111 000 ...
            
0000  E000          NOP         ; PC=0  → 000
0001  E000          NOP         ; PC=1  → 001
0002  E000          NOP         ; PC=2  → 010
0003  E000          NOP         ; PC=3  → 011
0004  E000          NOP         ; PC=4  → 100
0005  E000          NOP         ; PC=5  → 101
0006  E000          NOP         ; PC=6  → 110
0007  E000          NOP         ; PC=7  → 111
0008  4000          JMP 0       ; PC=8, jump back to 0
