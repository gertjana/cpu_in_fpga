Addr    Word  Source
--------------------------------------------------------------
              ; fibonacci.asm — compute Fibonacci numbers until the next value would
              ;                 overflow an 8-bit unsigned integer (> 255), storing
              ;                 each result in RAM and keeping the latest in R7.
              ; clk_div: 20
              ; name: Fibonacci
              ;
              ; Algorithm (iterative):
              ;   fib(0) = 0
              ;   fib(1) = 1
              ;   fib(i) = fib(i-2) + fib(i-1)   for i >= 2
              ;   Stop when fib(i-2) + fib(i-1) overflows 8 bits (carry flag set).
              ;
              ; Register use:
              ;   R0 = loop index i (RAM address pointer)
              ;   R1 = fib[i-2]  (a)
              ;   R2 = fib[i-1]  (b)
              ;   R3 = fib[i]    (next = a + b)
              
              .equ BASE, 0           ; RAM base address
              
              ; ── initialise ────────────────────────────────────────────────────────────────
              
0000  204000          LDI  R1, 0          ; a = fib(0) = 0
0001  208001          LDI  R2, 1          ; b = fib(1) = 1
0002  200000          LDI  R0, BASE       ; R0 = RAM address pointer
              
0003  240100          ST   [R0], R1       ; RAM[0] = 0
0004  100001          ADDI R0, R0, 1      ; advance pointer
0005  240200          ST   [R0], R2       ; RAM[1] = 1
0006  100001          ADDI R0, R0, 1      ; advance pointer  (R0 now points to RAM[2])
              
              ; ── main loop ─────────────────────────────────────────────────────────────────
              
              loop:
0007  006500          ADD  R3, R1, R2     ; next = a + b; carry set if > 255
0008  46000F          JC   done           ; overflow → stop, R7 holds last valid result
              
0009  964000          OUT  R3, 2          ; display on LEDs
000A  240300          ST   [R0], R3       ; RAM[i] = fib(i)
000B  100001          ADDI R0, R0, 1      ; advance pointer
              
000C  328000          MOV  R1, R2         ; a = b
000D  34C000          MOV  R2, R3         ; b = next
000E  400007          JMP  loop
              
              ; ── halt ──────────────────────────────────────────────────────────────────────
              
              done:
000F  F00000          HALT
