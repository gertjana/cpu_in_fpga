Addr    Word  Source
--------------------------------------------------------------
              ; flag_test.asm — exercise Z, C, N, V flags and halt with C=1, V=1
              ; clk_div: 20
              ;
              ; ── test Z ────────────────────────────────────────────────────────────────────
0000  040000          XOR  R0, R0, R0     ; R0 = 0x00 → Z=1
0001  420003          JZ   z_ok
0002  F00000          HALT                ; fail guard
              z_ok:
              
              ; ── test N ────────────────────────────────────────────────────────────────────
0003  052000          NOT  R1, R0         ; R1 = 0xFF → N=1
0004  4A0006          JN   n_ok
0005  F00000          HALT                ; fail guard
              n_ok:
              
              ; ── test C ────────────────────────────────────────────────────────────────────
0006  208001          LDI  R2, 1          ; R2 = 0x01
0007  006500          ADD  R3, R1, R2     ; 0xFF + 0x01 = 0x00 → C=1
0008  46000A          JC   c_ok
0009  F00000          HALT                ; fail guard
              c_ok:
              
              ; ── test V, and leave C=1 V=1 as final state ──────────────────────────────────
000A  210020          LDI  R4, 0x20       ; R4 = 0x20
000B  069000          SHL  R4, R4         ; R4 = 0x40
000C  069000          SHL  R4, R4         ; R4 = 0x80
000D  00F200          ADD  R7, R4, R4     ; 0x80 + 0x80 = 0x00 → C=1 V=1
000E  4C0010          JV   v_ok
000F  F00000          HALT                ; fail guard
              v_ok:
              
              ; ── halt with C=1, V=1 ────────────────────────────────────────────────────────
0010  F00000          HALT
