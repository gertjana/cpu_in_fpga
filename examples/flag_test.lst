Addr  Word  Source
------------------------------------------------------------
            ; flag_test.asm — exercise Z, C, N, V flags and halt with C=1, V=1
            ; clk_div: 20
            ;
            ; ── test Z ────────────────────────────────────────────────────────────────────
0000  0004          XOR  R0, R0, R0     ; R0 = 0x00 → Z=1
0001  4203          JZ   z_ok
0002  F000          HALT                ; fail guard
            z_ok:
            
            ; ── test N ────────────────────────────────────────────────────────────────────
0003  0205          NOT  R1, R0         ; R1 = 0xFF → N=1
0004  4A06          JN   n_ok
0005  F000          HALT                ; fail guard
            n_ok:
            
            ; ── test C ────────────────────────────────────────────────────────────────────
0006  2081          LDI  R2, 1          ; R2 = 0x01
0007  0650          ADD  R3, R1, R2     ; 0xFF + 0x01 = 0x00 → C=1
0008  460A          JC   c_ok
0009  F000          HALT                ; fail guard
            c_ok:
            
            ; ── test V, and leave C=1 V=1 as final state ──────────────────────────────────
000A  2120          LDI  R4, 0x20       ; R4 = 0x20
000B  0906          SHL  R4, R4         ; R4 = 0x40
000C  0906          SHL  R4, R4         ; R4 = 0x80
000D  0F20          ADD  R7, R4, R4     ; 0x80 + 0x80 = 0x00 → C=1 V=1
000E  4C10          JV   v_ok
000F  F000          HALT                ; fail guard
            v_ok:
            
            ; ── halt with C=1, V=1 ────────────────────────────────────────────────────────
0010  F000          HALT
