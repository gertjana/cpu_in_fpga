Addr    Word  Source
--------------------------------------------------------------
              ; count_to_9.asm — count from 0 to 9, then halt
              ; clk_div: 20
              ; name: Count to 9
              ;           12 MHz / 2^20 ≈ 11.4 Hz
              ;
              ; R0 = counter (starts at 0, increments to 9)
              ; R1 = limit   (constant 9 — loop exits when R0 == 9, i.e. after counting 0..9)
              ;
              ; Expected final state: R0 = 9, flags Z=1 C=0 N=0 V=0, CPU halted
              
              .equ LIMIT, 9
              
0000  200000          LDI  R0, 0          ; R0 = 0  (counter)
0001  204009          LDI  R1, LIMIT      ; R1 = 9 (loop bound)
              loop:
0002  100001          ADDI R0, R0, 1      ; R0++
0003  600800          CMP  R0, R1         ; set flags: R0 - R1
0004  440002          JNZ  loop           ; repeat while R0 != R1
0005  F00000          HALT
