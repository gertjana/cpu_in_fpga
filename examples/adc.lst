              ; adc.asm — MAX10 internal ADC demo
              ; clk_div: 20
              ; name: ADC Demo
              ;
              ; Continuously reads the 8-bit ADC value from the dedicated analogue input
              ; pin (ANAIN / PIN_D2) and displays it on the 8 onboard LEDs.
              ;
              ; Port map:
              ;   IN  Rd, 3  — read the ADC sampled value (0x00 = 0V, 0xFF = 3.3V)
              ;   OUT Ra, 2  — drive the 8 onboard LEDs
              ;
              ; Test circuit — potentiometer between GND and 3.3V:
              ;
              ;   3.3V ──┐
              ;         ┌┴┐ 
              ;         │ │ 10kΩ
              ;         │ │◄─────────── AIN (dedicated 3-pin header top-left, PIN_D2)
              ;         │ │
              ;         └┬┘
              ;   GND  ──┘
              
              .equ ADC_PORT,  0x03     ; Port 3 = MAX10 internal ADC (ANAIN / PIN_D2)
              .equ LEDS_PORT, 0x02     ; Port 2 = onboard LEDs
              
              loop:
0000  806000          IN   R0, ADC_PORT    ; sample ADC value into R0
0001  904000          OUT  R0, LEDS_PORT   ; display on LEDs
0002  400000          JMP  loop            ; repeat forever
